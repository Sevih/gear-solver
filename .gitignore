# (scripts/before-pack.mjs), still ignored if left over.
apps/desktop/release/
apps/desktop/resources/prod-cert/

# Steam capture plugin — dotnet build output (dist/ is already ignored globally)
tools/capture-steam/obj/
tools/capture-steam/bin/
apps/desktop/resources/capture-steam/

# PERSONAL account data — never commit. The dev capture folder is
# .cache/capture-out (ignored above).
*.log

# OS / editor
.DS_Store
Thumbs.db
.idea/

# env
.env
.env.local
