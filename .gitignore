# dependencies / build
node_modules/
dist/
build/
.vite/
*.tsbuildinfo
coverage/

# synced asset/data cache (images + game data pulled from the outerpedia repo)
.cache/

# Electron desktop — packaged builds + downloaded bundled binaries (adb, …),
# reproducible from scripts/fetch-binaries.mjs. prod-cert/ is a CA folder
# older builds generated (private key inside, NEVER commit): no longer
# produced nor packaged (scripts/before-pack.mjs), still ignored if left over.
apps/desktop/release/
apps/desktop/resources/bin/
apps/desktop/resources/prod-cert/

# Steam capture plugin — dotnet build output (dist/ is already ignored globally)
tools/capture-steam/obj/
tools/capture-steam/bin/
apps/desktop/resources/capture-steam/

# capture runtime artifacts & PERSONAL account data — never commit
tools/capture/out/
tools/capture/dumps/
*.flows
*.log
*.log.err

# mitmproxy CA private material / duplicate PEM (the hashed .0 is kept for the one-button flow)
tools/capture/cert/mitmproxy-ca-cert.pem
tools/capture/cert/*.p12
tools/capture/cert/*-ca.pem

# OS / editor
.DS_Store
Thumbs.db
.idea/

# env
.env
.env.local
