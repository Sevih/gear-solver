# dependencies / build
node_modules/
dist/
build/
.vite/
*.tsbuildinfo
coverage/

# synced asset/data cache (images + game data pulled from the outerpedia repo)
.cache/

# Electron desktop — packaged builds. prod-cert/ is a CA folder older builds
