{
  "name": "@gear-solver/desktop",
  "version": "1.18.0",
  "private": true,
  "description": "Electron shell that hosts the gear-solver renderer and the capture pipeline in a single distributable.",
  "author": "Outerpedia",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p .",
    "start": "electron .",
    "dev": "tsc -p . && electron .",
    "typecheck": "tsc -p . --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "fetch-binaries": "node scripts/fetch-binaries.mjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "publish": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3",
    "typescript": "^5.6.3",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "com.outerpedia.gear-solver",
    "productName": "Outerpedia Gear Solver",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "asar": true,
    "electronVersion": "44.9.3",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "buildDependenciesFromSource": false,
    "beforePack": "./scripts/before-pack.mjs",
    "extraMetadata": {
      "dependencies": {
        "electron-updater": "^6.8.9"
      }
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../data/derived",
        "to": "data/derived"
      },
      {
        "from": "../renderer/dist",
        "to": "renderer/dist"
      },
      {
        "from": "resources/capture-steam",
        "to": "capture-steam",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Outerpedia Gear Solver"
    },
    "publish": {
      "provider": "github",
      "owner": "Sevih",
      "repo": "gear-solver"
    }
  }
}
